ANTHROPIC_API_KEY=your_api_key_here

# Site password gate
SITE_PASSWORD=choose_a_password
# Random secret for signing the session cookie (e.g. `openssl rand -hex 32`)
AUTH_SECRET=

# Optional: override the default chat model (defaults to claude-fable-5)
# CASSANDRA_MODEL=claude-opus-4-8
# Optional: override the summarizer model (defaults to claude-haiku-4-5)
# CASSANDRA_FAST_MODEL=claude-haiku-4-5

# Set by Vercel Cron automatically at runtime; set your own value here too so
# the refresh endpoint can be tested locally with a matching header.
CRON_SECRET=

# Library persistence (saved articles, tracked topics) — set by the Vercel
# Upstash integration; without these, /api/library/* routes fail.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
